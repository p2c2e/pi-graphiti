{
  "name": "pi-graphiti",
  "version": "0.6.0",
  "description": "🕸️ Persistent knowledge graph for Pi via Graphiti MCP. Ambient recall, automatic episode writes on session events, /graph command.",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/preuninstall.mjs",
    "scripts/ingest-file.ts"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "preuninstall": "node scripts/preuninstall.mjs",
    "ingest": "npx tsx scripts/ingest-file.ts",
    "test:scope": "npx tsx scripts/test-scope.ts",
    "test:resilience": "npx tsx scripts/test-resilience.ts",
    "test:spool": "npx tsx scripts/test-spool.ts",
    "smoke": "bash scripts/smoke.sh",
    "smoke:uninstall": "bash scripts/smoke-uninstall.sh",
    "test": "npm run check && npm run test:scope && npm run test:resilience && npm run test:spool && npm run smoke:uninstall && npm run smoke",
    "prepublishOnly": "npm run check && npm run test:scope && npm run test:resilience && npm run test:spool"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "graphiti",
    "knowledge-graph",
    "falkordb",
    "mcp",
    "memory",
    "temporal-graph",
    "ambient-recall",
    "agent"
  ],
  "author": "Sudharsan Rangarajan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2c2e/pi-graphiti.git"
  },
  "bugs": {
    "url": "https://github.com/p2c2e/pi-graphiti/issues"
  },
  "homepage": "https://github.com/p2c2e/pi-graphiti#readme",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "typebox": "^1.1.33",
    "typescript": "^6.0.3"
  }
}
